diff --git a/hw/misc/ivshmem-pci.c b/hw/misc/ivshmem-pci.c
index 5a10bca633..eb773000a0 100644
--- a/hw/misc/ivshmem-pci.c
+++ b/hw/misc/ivshmem-pci.c
@@ -40,6 +40,8 @@
 #include "hw/misc/ivshmem.h"
 #include "qom/object.h"
 
+#include <linux/kvm.h>
+
 #define PCI_VENDOR_ID_IVSHMEM   PCI_VENDOR_ID_REDHAT_QUMRANET
 #define PCI_DEVICE_ID_IVSHMEM   0x1110
 
@@ -117,6 +119,10 @@ struct IVShmemState {
     /* migration stuff */
     OnOffAuto master;
     Error *migration_blocker;
+
+    /*protected*/
+    bool protected;
+    bool prot_applied;
 };
 
 /* registers for the Inter-VM shared memory device */
@@ -180,6 +186,11 @@ static void ivshmem_io_write(void *opaque, hwaddr addr,
     addr &= 0xfc;
 
     IVSHMEM_DPRINTF("writing to addr " HWADDR_FMT_plx "\n", addr);
+
+    // hwaddr bar2 = pci_get_bar_addr(PCI_DEVICE(s), 2);
+
+    // warn_report("bar 2 at " HWADDR_FMT_plx ", size %" PRIu64,
+    //             bar2, memory_region_size(s->ivshmem_bar2));
     switch (addr)
     {
         case INTRMASK:
@@ -812,6 +823,26 @@ static void ivshmem_disable_irqfd(IVShmemState *s)
 
 }
 
+
+static int kvm_set_prot_gpa_range(hwaddr start, hwaddr size) //like mprotect
+{
+    struct kvm_gpa_range attrs;
+    int r;
+
+    attrs.start = start;
+    attrs.size = size;
+
+    //PRINT HERE - GPA, USER ADDR, SIZE
+    warn_report("kvm_set_prot_gpa_range: addr=0x%" HWADDR_PRIx ", size=0x%" PRIx64,
+                start, size);
+
+    r = kvm_vm_ioctl(kvm_state, KVM_SET_PROT_GPA_RANGE, &attrs);
+    if (r) {
+        error_report("KVM_SET_PROT_GPA_RANGE failed: %s", strerror(errno));
+    }
+    return r;
+}
+
 static void ivshmem_write_config(PCIDevice *pdev, uint32_t address,
                                  uint32_t val, int len)
 {
@@ -828,6 +859,27 @@ static void ivshmem_write_config(PCIDevice *pdev, uint32_t address,
             ivshmem_disable_irqfd(s);
         }
     }
+    /* If BAR2 (64-bit) or COMMAND gets written, try to apply WO. */
+    /* BAR2 low dword:  0x18, BAR2 high dword: 0x1C */
+    bool bar2_written =
+        ranges_overlap(address, len, PCI_BASE_ADDRESS_2, 4) ||
+        ranges_overlap(address, len, PCI_BASE_ADDRESS_3, 4);
+    bool cmd_written = ranges_overlap(address, len, PCI_COMMAND, 2);
+
+    if (bar2_written || cmd_written) {
+        pcibus_t bar2 = pci_get_bar_addr(PCI_DEVICE(s), 2);
+        hwaddr start = bar2;
+        hwaddr size = memory_region_size(s->ivshmem_bar2);
+        warn_report("BAR2 GPA=0x" HWADDR_FMT_plx " size=0x" HWADDR_FMT_plx "\n",
+                    start, size);
+        Error *err = NULL;
+        if (kvm_set_prot_gpa_range(start, size)) {
+            /* Didn’t succeed: warn and keep trying only once to avoid spam */
+            s->prot_applied = true;  /* avoid loops; if you want retries, drop this */
+            return;
+        }
+        
+    }
 }
 
